{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markup-arcade-ph",
  "main": "worker/regional-gateway.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "ad5e0678ef8fa101846cfe82265d3db1",
  "workers_dev": true,
  "placement": {
    "region": "aws:ap-east-1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CASUAL_ROOMS",
        "class_name": "CasualRoom",
        "script_name": "markup-arcade"
      },
      {
        "name": "ARENA_ROOMS",
        "class_name": "ArenaRoom",
        "script_name": "markup-arcade"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "89871452-465b-4ebf-bfac-2c4b4c3aaf72",
      "migrations_dir": "drizzle"
    }
  ]
}
